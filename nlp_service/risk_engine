def classify_sif_potential_severity(scored_hazards: List[dict], sif_result: dict) -> dict:
    high_energy_hazards = [h for h in scored_hazards if h["is_high_energy"]]
    max_energy = max((h["energy_level"] for h in high_energy_hazards), default=0)
    classification = sif_result["classification"]

    if not high_energy_hazards:
        score = 1
    elif classification == "SIF Precursor - Direct Control Failure":
        score = 5
    elif classification == "SIF Precursor - Indirect Control Failure":
        score = 4 if max_energy >= 5 else 3
    else:
        score = 3 if max_energy >= 5 else 2

    level = SIF_POTENTIAL_LEVELS[score]

    return {
        "score": score,
        "label": level["label"],
        "description": level["description"],
        "recommended_action": level["recommended_action"],
        "dominant_energy_level": max_energy,
    }


def assess_risk(entities: Dict[str, List[str]]) -> dict:
    hazards = entities.get("hazards", [])
    activities = entities.get("activities", [])
    locations = entities.get("locations", [])
    barrier_failures = entities.get("barrier_failures", [])

    scored_hazards = [classify_hazard(text) for text in hazards]
    scored_activities = [classify_activity(text) for text in activities]
    scored_barriers = [classify_barrier_failure(text) for text in barrier_failures]

    severity = calculate_severity(scored_hazards)
    likelihood = calculate_likelihood(scored_activities, scored_barriers)
    risk_score = severity["score"] * likelihood["score"]
    matrix_level = determine_risk_level(risk_score)

    sif_result = determine_sif_precursor(scored_hazards, scored_barriers)
    final_risk_level = escalate_risk_level(matrix_level, sif_result)
    sif_potential = classify_sif_potential_severity(scored_hazards, sif_result)

    return {
        "sif_assessment": sif_result,
        "sif_potential_classification": sif_potential,
        "risk_matrix": {
            "likelihood": likelihood,
            "severity": severity,
            "risk_score": risk_score,
            "matrix_risk_level": matrix_level,
            "final_risk_level": final_risk_level,
        },
        "entity_breakdown": {
            "hazards": scored_hazards,
            "activities": scored_activities,
            "barrier_failures": scored_barriers,
            "locations": locations,
        },
    }