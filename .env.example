# Copy to .env and fill in real values. Never commit .env.
PORT=5000

# MongoDB (document metadata)
MONGO_URI=mongodb://127.0.0.1:27017/sifguard

# PostgreSQL — use ONE of these:
# Option A (recommended): full connection string
SQL_URI=postgresql://postgres:postgres@localhost:5432/sifguard
# Option B: individual fields
DB_USER=postgres
DB_HOST=localhost
DB_NAME=sifdb
DB_PASSWORD=docsort-1-0-0
DB_PORT=5432

# Auth
JWT_SECRET=hfgfg@SIFGUARD_HFHFH

# Existing NLP service (FastAPI). Do NOT point this at the Node backend.
NLP_SERVICE_URL=http://127.0.0.1:8000
# NLP_SERVICE_TIMEOUT_MS=120000
