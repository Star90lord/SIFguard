# SIFguard Backend Configuration
PORT=5000

# MongoDB (Document and Safety Intelligence Store)
MONGO_URI=mongodb://127.0.0.1:27017/sifguard

# PostgreSQL (Authentication & User Store)
# Option A: Connection String
SQL_URI=postgresql://postgres:postgres@localhost:5432/sifguard
# Option B: Individual Connection Fields
DB_USER=postgres
DB_HOST=localhost
DB_NAME=sifdb
DB_PASSWORD=postgres
DB_PORT=5432

# Security & JWT Authentication
JWT_SECRET=sifguard_super_secret_jwt_key_2026

# Python NLP Service (FastAPI)
NLP_SERVICE_URL=http://127.0.0.1:8000
NLP_SERVICE_TIMEOUT_MS=120000
