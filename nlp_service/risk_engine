DEFAULT_BARRIER = {"control_type": "unclassified", "weight": 1, "control_class": "indirect"}
DIRECT_CONTROL_THRESHOLD = 2


ACTIVITY_FREQUENCY = {
    "high": ["routine", "daily", "continuous", "repetitive", "standard operation", "every shift"],
    "low": ["occasional", "non-routine", "one-time", "rare", "infrequent", "emergency"],
}

RISK_LEVEL_BANDS = [
    (16, 25, "Critical"),
    (10, 15, "High"),
    (5, 9, "Medium"),
    (1, 4, "Low"),
]

RISK_LEVEL_ORDER = {"Low": 0, "Medium": 1, "High": 2, "Critical": 3}


def _match_category(text: str, table: dict, default: dict, key_field: str) -> dict:
    lowered = text.lower()
    for key, config in table.items():
        if any(keyword in lowered for keyword in config["keywords"]):
            result = dict(config)
            result[key_field] = key
            return result
    result = dict(default)
    result[key_field] = default.get(key_field, "unclassified")
    return result


def classify_hazard(text: str) -> dict:
    match = _match_category(text, HAZARD_CATEGORIES, DEFAULT_HAZARD, "category")
    return {
        "text": text,
        "category": match["category"],
        "energy_level": match["energy_level"],
        "severity_label": match["severity_label"],
        "is_high_energy": match["energy_level"] >= HIGH_ENERGY_THRESHOLD,
    }


def classify_barrier_failure(text: str) -> dict:
    match = _match_category(text, BARRIER_TYPES, DEFAULT_BARRIER, "control_type")
    return {
        "text": text,
        "control_type": match["control_type"],
        "weight": match["weight"],
        "control_class": match["control_class"],
        "is_direct_control_failure": match["weight"] >= DIRECT_CONTROL_THRESHOLD,
    }


def classify_activity(text: str) -> dict:
    lowered = text.lower()
    frequency = "medium"
    if any(keyword in lowered for keyword in ACTIVITY_FREQUENCY["high"]):
        frequency = "high"
    elif any(keyword in lowered for keyword in ACTIVITY_FREQUENCY["low"]):
        frequency = "low"
    return {"text": text, "frequency": frequency}


def calculate_severity(scored_hazards: List[dict]) -> dict:
    if not scored_hazards:
        return {"score": 1, "label": "Negligible", "driver": None}

    dominant = max(scored_hazards, key=lambda hazard: hazard["energy_level"])
    return {
        "score": dominant["energy_level"],
        "label": dominant["severity_label"],
        "driver": dominant["text"],
    }


def calculate_likelihood(scored_activities: List[dict], scored_barriers: List[dict]) -> dict:
    score = 3

    frequencies = [activity["frequency"] for activity in scored_activities]
    if "high" in frequencies:
        score += 1
    elif frequencies and all(freq == "low" for freq in frequencies):
        score -= 1

    total_weight = sum(barrier["weight"] for barrier in scored_barriers)
    score += min(total_weight // 2, 3)

    score = max(1, min(score, 5))

    labels = {1: "Rare", 2: "Unlikely", 3: "Possible", 4: "Likely", 5: "Almost Certain"}
    return {"score": score, "label": labels[score], "contributing_barrier_weight": total_weight}


def determine_risk_level(risk_score: int) -> str:
    for lower, upper, label in RISK_LEVEL_BANDS:
        if lower <= risk_score <= upper:
            return label
    return "Low"


def determine_sif_precursor(scored_hazards: List[dict], scored_barriers: List[dict]) -> dict:
    high_energy_hazards = [h for h in scored_hazards if h["is_high_energy"]]
    direct_failures = [b for b in scored_barriers if b["is_direct_control_failure"]]
    indirect_failures = [b for b in scored_barriers if not b["is_direct_control_failure"]]

    if not high_energy_hazards:
        return {
            "is_sif_precursor": False,
            "classification": "Non-SIF",
            "high_energy_hazards": [],
            "control_failures": [],
            "rationale": "No high-energy hazard identified in the report.",
        }

    if direct_failures:
        return {
            "is_sif_precursor": True,
            "classification": "SIF Precursor - Direct Control Failure",
            "high_energy_hazards": [h["text"] for h in high_energy_hazards],
            "control_failures": [b["text"] for b in direct_failures],
            "rationale": (
                "High-energy hazard present alongside a failed or absent direct "
                "(engineering/administrative) control."
            ),
        }

    if indirect_failures:
        return {
            "is_sif_precursor": True,
            "classification": "SIF Precursor - Indirect Control Failure",
            "high_energy_hazards": [h["text"] for h in high_energy_hazards],
            "control_failures": [b["text"] for b in indirect_failures],
            "rationale": (
                "High-energy hazard present with only a PPE-level control failure; "
                "direct controls appear intact."
            ),
        }

    return {
        "is_sif_precursor": False,
        "classification": "Potential SIF Exposure",
        "high_energy_hazards": [h["text"] for h in high_energy_hazards],
        "control_failures": [],
        "rationale": "High-energy hazard present but no barrier failure identified; monitor controls.",
    }


def escalate_risk_level(matrix_level: str, sif_result: dict) -> str:
    escalation_floor = "Low"
    if sif_result["classification"] == "SIF Precursor - Direct Control Failure":
        escalation_floor = "Critical"
    elif sif_result["classification"] == "SIF Precursor - Indirect Control Failure":
        escalation_floor = "High"
    elif sif_result["classification"] == "Potential SIF Exposure":
        escalation_floor = "Medium"

    if RISK_LEVEL_ORDER[escalation_floor] > RISK_LEVEL_ORDER[matrix_level]:
        return escalation_floor
    return matrix_level


SIF_POTENTIAL_LEVELS = {
